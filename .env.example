# Run python3 scripts/setup_local.py to generate .env with development secrets.
POSTGRES_DB=elasticscan
POSTGRES_USER=elasticscan
POSTGRES_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
LOCAL_USER_PASSWORD=
AWS_DEFAULT_REGION=us-east-1
# Dummy credentials for the local emulator only.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_ENDPOINT_URL=http://localstack:4566
SQS_ENDPOINT_URL=http://localstack:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:elasticscan-jobs
SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/elasticscan-zap
OIDC_ISSUER=http://localhost:8080/realms/elasticscan
OIDC_JWKS_URL=http://keycloak:8080/realms/elasticscan/protocol/openid-connect/certs
OIDC_AUDIENCE=elasticscan-api
OIDC_ALGORITHMS=RS256
OIDC_TEAM_CLAIM=team_ids
