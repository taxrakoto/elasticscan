{
  "realm": "elasticscan",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "elasticscan-dev",
      "name": "Local token client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "elasticscan-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "trusted-team-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "team_ids",
            "claim.name": "team_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "alice",
      "lastName": "Fixture",
      "email": "alice@example.invalid",
      "attributes": {
        "team_ids": [
          "team-alpha"
        ]
      }
    },
    {
      "username": "alice-peer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "alice-peer",
      "lastName": "Fixture",
      "email": "alice-peer@example.invalid",
      "attributes": {
        "team_ids": [
          "team-alpha"
        ]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "bob",
      "lastName": "Fixture",
      "email": "bob@example.invalid",
      "attributes": {
        "team_ids": [
          "team-beta"
        ]
      }
    }
  ]
}
